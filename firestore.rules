rules_version = '2';

// Aturan Firestore untuk AkashaStream.
//
// CARA PASANG: Firebase Console → Firestore Database → Rules → salin-tempel →
// Publish.
//
// KENAPA daftar pengguna sempat gagal walau aturan sudah diisi:
// Firestore mengevaluasi Rules PER DOKUMEN pada hasil query koleksi. Bila
// fungsi admin memakai exists()/get() di dalam aturan READ, query koleksi
// DITOLAK ("Missing or insufficient permissions").
//
// Karena itu aturan READ tidak memakai get()/exists() sama sekali, sementara
// aturan UPDATE (yang hanya menyentuh 1 dokumen) boleh memakainya.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Pemilik hanya boleh mengubah field profil; role & masa aktif TIDAK.
    function profileOnlyWrite() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['email', 'displayName', 'avatarUrl', 'lastLoginAt', 'updatedAt']);
    }

    match /users/{uid} {

      // ---- READ ----
      // Dibuka untuk semua pengguna yang login agar Admin Panel bisa memuat
      // DAFTAR pengguna. (Tanpa get()/exists(): query koleksi tetap diizinkan.)
      // Konsekuensi yang diterima: pengguna login bisa membaca dokumen
      // pengguna lain (email, displayName, accountType, activeUntil).
      allow read: if isSignedIn();

      // ---- CREATE ----
      // Dokumen dibuat sendiri saat login pertama. Admin menambah pengguna
      // lewat jalur update/set pada dokumen yang sudah ada.
      allow create: if isSelf(uid);

      // ---- UPDATE ----
      // Di sini get() aman karena update hanya menyentuh satu dokumen.
      //  - Developer (accountType == 'developers' pada dokumennya sendiri)
      //    boleh mengubah role & masa aktif pengguna lain.
      //  - Pemilik hanya boleh mengubah field profil.
      allow update: if isSelf(uid) && profileOnlyWrite()
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'developers');

      // Hapus hanya dari Console/Admin SDK.
      allow delete: if false;
    }
  }
}
